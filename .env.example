APP_NAME=
# local | production. Never leave a live host on "local": destructive tooling
# and future code will reasonably branch on this value. See
# docs/deploy/production-config.md.
APP_ENV=
# MUST be false on any live host. When true, unhandled exceptions return their
# message and the absolute server file path to the browser.
APP_DEBUG=

DB_CONNECTION=
PORTAL_DB_HOST=
PORTAL_DB_PORT=
PORTAL_DB_DATABASE=
PORTAL_DB_USERNAME=
PORTAL_DB_PASSWORD=

CHURCHCRM_DB_HOST=
CHURCHCRM_DB_PORT=
CHURCHCRM_DB_DATABASE=
CHURCHCRM_DB_USERNAME=
CHURCHCRM_DB_PASSWORD=

# Private archives (MySQL dumps, state snapshots, member xlsx). Default: storage/private
MAINTENANCE_PRIVATE_PATH=

PORTAL_SOURCE_OF_TRUTH=
PORTAL_BASE_PATH=
