APP_NAME=
# local | production. Never leave a live host on "local": destructive tooling
# and future code will reasonably branch on this value. See
# docs/deploy/production-config.md.
APP_ENV=
# MUST be false on any live host. When true, unhandled exceptions return their
# message and the absolute server file path to the browser.
APP_DEBUG=

# Member database (MySQL): people, households, ministries, calendar, schedules, logins.
MEMBERS_DB_HOST=
MEMBERS_DB_PORT=
MEMBERS_DB_DATABASE=
MEMBERS_DB_USERNAME=
MEMBERS_DB_PASSWORD=

# Visitors database (SQLite): guest sign-ups and RSVPs until promoted.
# Relative to the app root. Default: storage/private/database/visitors.sqlite
VISITORS_DB_PATH=

# Private archives (database backups, state snapshots, member xlsx). Default: storage/private
MAINTENANCE_PRIVATE_PATH=

PORTAL_BASE_PATH=

# --- Where this installation is reachable ---------------------------------
# Used to build the Google callback address and the sign-in links sent by
# mail. Read from configuration, never from the request's Host header: a host
# header is something the client sends, so a link built from one is a link
# somebody can point at their own server.
#
# Include the base path when the portal is mounted under one.
#   local:  http://localhost:8000
#   demo:   https://ekklesiademo.crishub.com
APP_URL=

# --- Signing in with Google -----------------------------------------------
# Both must be set, with APP_URL, or the sign-in screen does not offer Google.
# It never offers a button that cannot work.
#
# In the Google Cloud console, create an OAuth 2.0 Client ID of type "Web
# application" and add this exact authorized redirect URI:
#
#     ${APP_URL}/auth/google/callback
#
# Scopes are openid, email and profile — who somebody is, and nothing else.
# No Gmail, Drive or Calendar access is requested.
#
# Google proves identity; it grants nothing. An account exists here because an
# administrator provisioned it, and a Google identity that has no account here
# is refused rather than welcomed.
#
# NEVER commit filled-in values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Sending mail ---------------------------------------------------------
# What sign-in links travel on. Leave MAIL_TRANSPORT unset and this
# installation cannot send mail, so the sign-in screen does not offer a link.
#
#   smtp  a relay. The church's Google Workspace mailbox is one of these
#         (smtp.gmail.com, port 587, an app password as MAIL_PASSWORD), so
#         moving to it later is these settings and nothing else.
#   file  write each message under private storage instead of sending it, for
#         development, where a sign-in link still has to be readable.
MAIL_TRANSPORT=

MAIL_HOST=
# Defaults to 587, or 465 when MAIL_ENCRYPTION=ssl.
MAIL_PORT=
# tls (STARTTLS, the usual), ssl (implicit TLS, port 465), or none.
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
# NEVER commit this.
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# MAIL_TRANSPORT=file only. Default: <MAINTENANCE_PRIVATE_PATH>/mail
# Never inside the web root: a sign-in link is a credential while it lives.
MAIL_FILE_PATH=
