{
  "name": "christlikeness/church-portal",
  "description": "Operational leader and member portal layered over ChurchCRM data.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11.0",
    "inertiajs/inertia-laravel": "^1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test:architecture": "php tests/Architecture/BoundaryTest.php",
    "test:regression": "php tests/Regression/run.php && php tests/Regression/schedule-event-scope.php"
  }
}
